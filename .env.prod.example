# Copy to .env.prod and fill secrets securely; never commit .env.prod.
DOMAIN=example.com
SECRET_KEY=
DATABASE_NAME=antrakt
DATABASE_USER=antrakt
DATABASE_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=antrakt-images
# Leave disabled until the reviewed, backed-up relationship import is complete.
PERFORMANCE_RELATIONS_ENABLED=False
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Optional VK integration; use one supported credential source.
VK_SESSION_COOKIE=
VK_ACCESS_TOKEN=
VK_GROUP_DOMAIN=tc_antrakt
# auto retains legacy cookie priority. Select api after validating your API access.
VK_IMPORT_BACKEND=auto
# 14 days; 0 disables scheduling, manual imports still work.
VK_IMPORT_INTERVAL_SECONDS=1209600
VK_IMPORT_MAX_ATTEMPTS=3
VK_IMPORT_MAX_COMMENTS=10000
